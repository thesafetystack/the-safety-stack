{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risks-1.schema.json",
  "title": "Risk taxonomy, schema 1 (catalogue envelope; risks 0.3.0 on)",
  "description": "One entries list: families (node family) and risks (node risk, parent a family). The validator checks what a schema cannot say: unique ids, every risk's parent is a family, every family has a risk, vs names another entry, ids named in the text resolve, meta.retired ids are no entry. Adds meta.retired to risks-0.",
  "allOf": [
    {
      "$ref": "catalogue-0.schema.json"
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "meta": {
      "type": "object",
      "required": [
        "schema",
        "updated",
        "status",
        "description",
        "rules",
        "relations"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "risks-1"
        },
        "updated": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "released"
          ]
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "type": "object"
        },
        "rules": {
          "$ref": "#/$defs/glosses"
        },
        "relations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mitigates",
            "measures",
            "demonstrates",
            "discusses"
          ],
          "properties": {
            "mitigates": {
              "$ref": "#/$defs/text"
            },
            "measures": {
              "$ref": "#/$defs/text"
            },
            "demonstrates": {
              "$ref": "#/$defs/text"
            },
            "discusses": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "fields": {
          "$ref": "#/$defs/glosses"
        },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sev",
            "hor",
            "ben"
          ],
          "properties": {
            "sev": {
              "$ref": "#/$defs/glosses"
            },
            "hor": {
              "$ref": "#/$defs/glosses"
            },
            "ben": {
              "$ref": "#/$defs/glosses"
            }
          }
        },
        "crosswalk_keys": {
          "$ref": "#/$defs/glosses"
        },
        "retired": {
          "$ref": "#/$defs/glosses"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "id": {
      "$ref": "catalogue-0.schema.json#/$defs/id"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "glosses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "status": {
      "enum": [
        "draft",
        "provisional",
        "final"
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "node"
      ],
      "properties": {
        "node": {
          "enum": [
            "family",
            "risk"
          ]
        }
      },
      "if": {
        "properties": {
          "node": {
            "const": "family"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/family"
      },
      "else": {
        "$ref": "#/$defs/risk"
      }
    },
    "family": {
      "type": "object",
      "required": [
        "id",
        "node",
        "name",
        "status",
        "definition"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        "node": {
          "const": "family"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "definition": {
          "$ref": "#/$defs/text"
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "id",
        "node",
        "name",
        "parent",
        "status",
        "definition",
        "attrs",
        "mit",
        "siblings"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2}\\.[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "node": {
          "const": "risk"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "definition": {
          "$ref": "#/$defs/text"
        },
        "exclude": {
          "$ref": "#/$defs/text"
        },
        "facets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "contested": {
          "const": true
        },
        "vs": {
          "$ref": "#/$defs/id"
        },
        "attrs": {
          "type": "object",
          "required": [
            "sev",
            "hor",
            "ben"
          ],
          "additionalProperties": false,
          "properties": {
            "sev": {
              "enum": [
                "C",
                "S",
                "I"
              ]
            },
            "hor": {
              "enum": [
                "N",
                "F",
                "B"
              ]
            },
            "ben": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "dev",
                  "usr",
                  "3rd",
                  "soc",
                  "hum",
                  "ai"
                ]
              }
            }
          }
        },
        "mit": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[1-7]\\.[1-9]$"
          }
        },
        "siblings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      },
      "dependentRequired": {
        "contested": [
          "vs"
        ],
        "vs": [
          "contested"
        ]
      }
    }
  }
}
