{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk-generators-0.schema.json",
  "title": "Risk-generator taxonomy, major version 0 (catalogue envelope; risk-generators 0.3.0 on)",
  "description": "One entries list: families (node family) and generators (node generator, parent a family). feeds, weakens and the meta.risk_edges risk and escalates_to are references {id, name} into the risks taxonomy version meta.references.risks; the validator checks they resolve there with that name, that technique-family values are in meta.technique_families, that weakens comes with the barrier role, and the envelope checks.",
  "allOf": [{"$ref": "catalogue-0.schema.json"}],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+$"},
    "meta": {
      "type": "object",
      "required": ["schema", "updated", "status", "description", "references", "technique_families"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "risk-generators-0"},
        "updated": {"type": "string"},
        "status": {"enum": ["draft", "released"]},
        "description": {"$ref": "#/$defs/text"},
        "sources": {"type": "object"},
        "references": {"type": "object", "required": ["risks"], "additionalProperties": false,
                       "properties": {"risks": {"type": "string"}}},
        "fields": {"$ref": "#/$defs/glosses"},
        "technique_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "crosswalk_keys": {"$ref": "#/$defs/glosses"},
        "risk_edges": {"type": "array", "items": {"$ref": "#/$defs/risk_edge"}}
      }
    },
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "id": {"$ref": "catalogue-0.schema.json#/$defs/id"},
    "risk": {"$ref": "catalogue-0.schema.json#/$defs/ref"},
    "risks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/risk"}},
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "glosses": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/text"}},
    "status": {"enum": ["draft", "provisional", "final"]},
    "searched_by": {"enum": ["model", "attacker", "selection"]},
    "risk_edge": {
      "type": "object",
      "required": ["risk"],
      "minProperties": 2,
      "additionalProperties": false,
      "properties": {
        "risk": {"$ref": "#/$defs/risk"},
        "defeats": {"$ref": "#/$defs/ids"},
        "bypasses": {"$ref": "#/$defs/ids"},
        "escalates_to": {"$ref": "#/$defs/risks"},
        "searched_by": {"$ref": "#/$defs/searched_by"}
      }
    },
    "common_cause": {
      "type": "object",
      "required": ["mech", "scope"],
      "additionalProperties": false,
      "properties": {
        "mech": {"type": "array", "minItems": 1, "uniqueItems": true,
                 "items": {"enum": ["substrate", "convergent", "operational", "institutional", "epistemic",
                                    "environmental"]}},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["stack", "field"]}},
        "searched_by": {"$ref": "#/$defs/searched_by"},
        "defeats": {"$ref": "#/$defs/ids"},
        "note": {"$ref": "#/$defs/text"}
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "node"],
      "properties": {"node": {"enum": ["family", "generator"]}},
      "if": {"properties": {"node": {"const": "family"}}},
      "then": {"$ref": "#/$defs/family"},
      "else": {"$ref": "#/$defs/generator"}
    },
    "family": {
      "type": "object",
      "required": ["id", "node", "name", "status", "definition"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2}$"},
        "node": {"const": "family"},
        "name": {"$ref": "#/$defs/text"},
        "status": {"$ref": "#/$defs/status"},
        "definition": {"$ref": "#/$defs/text"},
        "note": {"$ref": "#/$defs/text"}
      }
    },
    "generator": {
      "type": "object",
      "required": ["id", "node", "name", "parent", "status", "definition", "tier", "role", "reduced_by", "crosswalks"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2}\\.[a-z0-9]+(-[a-z0-9]+)*$"},
        "node": {"const": "generator"},
        "name": {"$ref": "#/$defs/text"},
        "parent": {"$ref": "#/$defs/id"},
        "status": {"$ref": "#/$defs/status"},
        "definition": {"$ref": "#/$defs/text"},
        "tier": {"enum": ["annotate", "curated"]},
        "background": {"const": true},
        "role": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["hazard", "cause", "barrier"]}},
        "feeds": {"$ref": "#/$defs/risks"},
        "weakens": {"$ref": "#/$defs/risks"},
        "reduced_by": {"$ref": "#/$defs/ids"},
        "assessed_by": {"$ref": "#/$defs/ids"},
        "common_cause": {"$ref": "#/$defs/common_cause"},
        "note": {"$ref": "#/$defs/text"},
        "contested": {"const": true},
        "vs": {"$ref": "#/$defs/text"},
        "crosswalks": {"$ref": "#/$defs/texts"}
      },
      "anyOf": [{"required": ["feeds"]}, {"required": ["weakens"]}],
      "dependentRequired": {"contested": ["vs"], "vs": ["contested"]}
    }
  }
}
